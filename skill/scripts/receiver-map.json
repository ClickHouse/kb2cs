{
 "_meta": {
  "purpose": "Elastic integration field -> OTel receiver metric. Machine-readable twin of references/integration-to-receiver.md; used by scripts/plan-collector.py.",
  "verified": "2026-09-18",
  "source": "each receiver's documentation.md / metadata.yaml in opentelemetry-collector-contrib",
  "verdicts": {
   "default": "the receiver emits it with a default config -- nothing to configure",
   "optional": "the receiver has it but it is OFF by default -- enable it explicitly",
   "check": "a near equivalent exists but the semantics or the attribute value were not confirmed",
   "absent": "no equivalent on this receiver -- see `alternative`",
   "derive": "no metric needed; compute it in the tile from others -- see `how`",
   "dimension": "not a metric at all; it becomes an attribute -- see `how`"
  },
  "reshaped": "true when several source fields collapse into one metric carrying a dimension"
 },
 "receivers": {
  "nginx": {
   "component": "nginxreceiver"
  },
  "apache": {
   "component": "apachereceiver",
   "warning": "a feature gate renames these to apache.request.count / apache.worker.status / apache.connection.status and moves the attributes to apache.*.state"
  },
  "mysql": {
   "component": "mysqlreceiver"
  },
  "postgresql": {
   "component": "postgresqlreceiver"
  },
  "hostmetrics": {
   "component": "hostmetricsreceiver",
   "note": "per-scraper; every *.utilization metric is optional and the default is the absolute counter"
  },
  "sqlquery": {
   "component": "sqlqueryreceiver",
   "warning": "metrics support is ALPHA; metric names are whatever the operator's SELECT aliased"
  }
 },
