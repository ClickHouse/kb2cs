# Copy to .env (gitignored) and fill in. `set -a; . ./.env; set +a` to export the lot.
#
# Nothing here is read automatically -- the scripts read the ENVIRONMENT, so the values have
# to be exported into the shell that runs them. That is deliberate: a config file the tools
# read themselves is a config file that gets committed.

# ---- source: Kibana + Elasticsearch ---------------------------------------------------
KIBANA_URL=https://my-deployment.kb.europe-west1.gcp.cloud.es.io
# The `encoded` field from POST /_security/api_key -- not `id`, not `api_key`. Required on
# Elastic Serverless, and the only option wherever SAML/OIDC SSO has displaced basic auth.
KIBANA_API_KEY=
# Self-managed alternative to the API key:
#KIBANA_USER=elastic
#KIBANA_PASS=
# Most non-trivial deployments use Spaces. Querying only the default one makes a populated
# deployment look empty; pass --all-spaces to export-dashboards.sh, or name one here.
#KIBANA_SPACE=obs-team

ES_URL=https://my-deployment.es.europe-west1.gcp.cloud.es.io:9243
ES_USER=elastic
ES_PASSWORD=

# ---- target: ClickStack / HyperDX -----------------------------------------------------
CLICKSTACK_MCP_URL=https://hdx.example.com/api/mcp
CLICKSTACK_API_KEY=

# ---- target: ClickHouse ---------------------------------------------------------------
# Set CLICKHOUSE_URL for any remote cluster, including ClickHouse Cloud -- it is the only
# route that works there.
CLICKHOUSE_URL=https://abc123.europe-west4.gcp.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ...or, INSTEAD of CLICKHOUSE_URL, exec into a local container. The bundled all-in-one image
# needs a password on 8123 that its own clickhouse-client does not, which is why this route
# exists at all.
#CLICKSTACK_CONTAINER=clickstack
#CLICKSTACK_COMPOSE_DIR=./reference-stack/stack/clickstack

# ---- optional -------------------------------------------------------------------------
# Pin the comparison window instead of deriving it from the data.
#TILEDIFF_WIN_START=2026-09-16T15:00:00Z
#TILEDIFF_WIN_END=2026-09-17T14:00:00Z
